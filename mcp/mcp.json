{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "learn-go-with-tests": {
      "type": "http",
      "url": "https://quii.gitbook.io/learn-go-with-tests/~gitbook/mcp"
    },
    "jira": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "<JIRA_BASE_URL>",
        "JIRA_PERSONAL_TOKEN": "<JIRA_PERSONAL_ACCESS_TOKEN>",
        "CONFLUENCE_URL": "<CONFLUENCE_BASE_URL>",
        "CONFLUENCE_PERSONAL_TOKEN": "<CONFLUENCE_PERSONAL_ACCESS_TOKEN>"
      }
    },
    "obsidian": {
      "type": "http",
      "url": "https://127.0.0.1:27124/mcp/",
      "headers": {
        "Authorization": "Bearer <PERSONAL_LOCAL_REST_API_KEY>"
      }
    },
    "gradle": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "<ABS_PATH_TO>/gradle-mcp",
        "gradle-mcp"
      ],
      "env": {
        "GRADLE_PROJECT_ROOT": "<ABS_PATH_TO_KMP_REPO>"
      }
    },
    "allure": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "mcp",
        "run",
        "<ABS_PATH_TO>/mcp-allure/mcp-allure-server.py"
      ]
    },
    "idea": {
      "type": "http",
      "url": "http://127.0.0.1:64342/stream"
    },
    "pycharm": {
      "type": "http",
      "url": "http://127.0.0.1:<PYCHARM_MCP_PORT>/stream"
    }
  }
}
